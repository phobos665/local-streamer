{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local Streamer",
  "version": "0.1.0",
  "identifier": "dev.local.streamer",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Local Streamer",
        "width": 1280,
        "height": 720,
        "minWidth": 320,
        "minHeight": 180,
        "backgroundColor": "#000000",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
